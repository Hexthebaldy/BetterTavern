# 复制成 apps/server/.env 后按需修改（服务端从工作目录下的 .env 读取）。

ENV=dev
LOG_LEVEL=INFO
# 终端里的日志格式：auto（终端里是带颜色的单行，否则是 JSON）、console、json
LOG_FORMAT=auto
# 另写一份 JSON 日志到 .data/logs/api.log、worker.log（vis 读的就是它）；不设置时开发环境写、生产环境不写
# LOG_TO_FILE=true
# 日志默认不含故事文本；设为 true 只在开发环境（ENV=dev）生效
LOG_STORY_TEXT=false

DATABASE_URL=postgresql+asyncpg://bettertavern:bettertavern@localhost:5432/bettertavern

# 密钥：MASTER_KEYS 加密保存玩家的模型 Key（格式 "kid:base64"，多个用逗号隔开，第一个用于加密，
# 其余只用于解密旧数据，轮换时把新的放最前面）；AUTH_SECRET 签发登录令牌（至少 32 个字符）。
# 用 `uv run bettertavern keygen` 生成。开发环境留空时自动生成并保存在 .data/dev-secrets.json；
# 生产环境（ENV=prod）必须配置。主密钥丢了，已保存的模型 Key 就解不开了
# MASTER_KEYS=
# AUTH_SECRET=

# 只有网页和接口不同源时才需要（手机 App 不受 CORS 限制），多个用逗号隔开
# CORS_ORIGINS=
# 网页端放刷新令牌的 Cookie 带不带 Secure；不设置时开发环境不带（Safari 在 http://localhost 上不保存带 Secure 的 Cookie），其他环境带
# AUTH_COOKIE_SECURE=

# 只允许 https 和公网地址。自己部署、想接本机 Ollama 时可以设为 true；多人共用的公开服务不要打开
# 本机开着 Clash 等代理的 fake-ip（增强模式）时，所有域名都解析到 198.18.0.0/15，会报“解析到内网或保留地址”：
# 本地开发可以设为 true，或者把模型服务的域名（如 +.deepseek.com、+.huggingface.co）加进代理的 fake-ip-filter，
# 或者用下面的 FAKE_IP_RANGES 只放行假 IP 段
ALLOW_PRIVATE_ENDPOINTS=false
# 当作外网放行的“假 IP 段”，逗号隔开。开着 Clash fake-ip 时写 198.18.0.0/15，就不用打开上面那一项
# FAKE_IP_RANGES=
# 出站代理（可选），例如 http://127.0.0.1:7890
# OUTBOUND_PROXY=

# M0 的 SSE 探针接口；生产环境设为 false
ENABLE_PROBE_ENDPOINTS=true

# 反向代理的地址，逗号隔开，可以写网段：只有来自这些地址的请求才采信 X-Forwarded-For 里的真实 IP
# （注册、登录的限流按它计数）。默认只信本机；代理在别的机器或容器里时把它的地址加进来
# FORWARDED_ALLOW_IPS=127.0.0.1,::1

# 账号。REGISTRATION_OPEN=false 时不能注册新账号（出问题时先止血）
# REGISTRATION_OPEN=true
# 发信（验证码、找回密码、报错提醒）：Resend 的 API key 和发件人，发件人的域名要先在 Resend 里验证。
# 配了 key 就默认要求注册时验证邮箱（EMAIL_VERIFICATION 可以单独开关）；没配时开发环境把验证码写进日志（mail.dev_outbox），
# 生产环境不发信、不要求验证、不能找回密码
# RESEND_API_KEY=
# MAIL_FROM=BetterTavern <noreply@example.com>
# EMAIL_VERIFICATION=
# 服务报错时发邮件到这个地址：同一段时间（ALERT_INTERVAL_S，默认 900 秒）的报错合成一封，只写事件名和次数
# ALERT_EMAIL=
# ALERT_INTERVAL_S=900

# 内容规则：open（默认，自己部署的不管）/ sfw（官方服务：写故事、写卡的提示词里加内容边界；不审核用户存的卡）
# CONTENT_POLICY=open

# 官方模型：运营方自己的 Key，用户不用配置就能写，按用量扣点数（1 点 = 0.001 元）。不配 PLATFORM_API_KEY 就没有官方模型。
# 老用户第一次配上以后跑一次 `bettertavern credits-backfill`，给已经验证过邮箱的账号补上官方模型和体验额度
# PLATFORM_API_KEY=
# PLATFORM_PROVIDER=deepseek
# PLATFORM_MODEL=deepseek-flash
# PLATFORM_BASE_URL=
# 单价：元 / 百万 token（没命中缓存的输入、命中缓存的输入、输出），默认是 DeepSeek 白天的价格
# PLATFORM_PRICE_INPUT=2.0
# PLATFORM_PRICE_CACHED=0.04
# PLATFORM_PRICE_OUTPUT=8.0
# 这把 Key 同时最多几个请求（全站共用）
# PLATFORM_CONCURRENCY=32
# 新用户验证邮箱后送多少点（每个邮箱一次）
# TRIAL_CREDITS=1500
# 全站最近 24 小时在官方模型上最多花多少元，超过就暂停官方模型（报错提醒会发邮件）
# PLATFORM_DAILY_BUDGET=50
# 没有足够记录时，估计每回合花多少点（设置页显示“约能写几回合”用）
# PLATFORM_TURN_POINTS=40

# 官方搜索：工作台 agent 查资料时，用户自己没配搜索就用运营方的 Key（只用免费额度，不扣点数）。
# 次数用完了、或者不配这个 Key，agent 改查维基百科（不用 Key）
# PLATFORM_SEARCH_API_KEY=
# PLATFORM_SEARCH_PROVIDER=tavily
# 每个用户每天最多几次、全站每个月最多几次（Tavily 免费每月 1000 次，留一点余量）
# PLATFORM_SEARCH_DAILY=30
# PLATFORM_SEARCH_MONTHLY=950

# 每个用户的上限：工作台里花钱、占地方的操作每分钟几次；同时在写的 agent 几个；没保存的草稿几份；存的图一共多少字节
# RATE_LIMIT_WORKBENCH_PER_MIN=20
# MAX_RUNNING_AGENTS=2
# MAX_OPEN_DRAFTS=50
# MAX_IMAGE_BYTES_PER_USER=209715200

# 导演写一段的总时长上限（秒），超过就停下、这一轮按失败结束；总字数上限按模型的 max_tokens 换算
# DIRECTOR_TIMEOUT_S=600

# 切章：这一章的原文超过 SOFT 个 token 以后，在下一个场景结束处切一章，写章节摘要；
# 一直没有场景结束，到 HARD 时硬切。以后按剧本试玩的结果调
# CHAPTER_SOFT_TOKENS=8000
# CHAPTER_HARD_TOKENS=16000

WORKER_CONCURRENCY=4

# 合规率评测用的密钥（只在本机使用，不要提交）
# DEEPSEEK_API_KEY=
# HF_TOKEN=
