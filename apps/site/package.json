{
  "name": "bettertavern-site",
  "version": "0.1.0",
  "private": true,
  "description": "项目的落地页：构建时预渲染成静态 HTML，浏览器里再接上交互",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist/.ssr && node --experimental-strip-types scripts/prerender.ts",
    "preview": "vite preview",
    "test": "node --test --experimental-strip-types",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@bettertavern/design": "*",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/noto-serif-jp": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.1"
  }
}
