{
  "name": "bettertavern-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "setup": "expo install expo-router expo-linking expo-constants expo-status-bar react-native-safe-area-context react-native-screens expo-secure-store expo-document-picker react react-native && expo install typescript @types/react -- --save-dev",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --test --experimental-strip-types",
    "typecheck": "tsc --noEmit",
    "probe": "node --experimental-strip-types scripts/probe-cli.mts"
  },
  "dependencies": {
    "@bettertavern/core": "*",
    "@bettertavern/design": "*",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@types/react": "~19.2.4",
    "expo": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.26",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "i18next": "26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.0.15",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
