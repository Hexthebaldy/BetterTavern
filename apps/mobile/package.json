{
  "name": "bettertavern-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "setup": "expo install expo-router expo-linking expo-constants expo-status-bar react-native-safe-area-context react-native-screens react react-native && expo install typescript @types/react -- --save-dev",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "node --test --experimental-strip-types",
    "typecheck": "tsc --noEmit",
    "probe": "node --experimental-strip-types scripts/probe-cli.mts"
  },
  "dependencies": {
    "@types/react": "~19.2.4",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "typescript": "~6.0.3"
  }
}
