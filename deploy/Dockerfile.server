# 后端镜像：api、worker、migrate 共用。构建上下文是仓库根目录。
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv

WORKDIR /app
COPY apps/server/pyproject.toml apps/server/uv.lock* ./
RUN uv sync --no-dev --no-install-project $( [ -f uv.lock ] && echo --frozen )

COPY apps/server/ ./
RUN uv sync --no-dev $( [ -f uv.lock ] && echo --frozen )

RUN useradd --create-home --uid 10001 app
USER app

ENV PATH="/app/.venv/bin:$PATH" \
    ALEMBIC_CONFIG=/app/alembic.ini

EXPOSE 8000
CMD ["bettertavern", "serve", "--host", "0.0.0.0", "--port", "8000"]
