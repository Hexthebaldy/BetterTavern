flowchart TD
    start["拼好上下文"] --> q{"提供召回工具吗"}
    q -- 否 --> plain["一次流式请求，不带工具"]
    q -- 是 --> r1["第 1 轮：带召回工具"]
    r1 --> t1{"模型调用了工具"}
    t1 -- 否 --> write["边写边推给玩家"]
    t1 -- 是 --> ex1["推 director.recalling<br/>执行工具，结果放进 ＜recall＞ 接回去"]
    ex1 --> r2["第 2 轮：还带工具"]
    r2 --> t2{"又调用了工具"}
    t2 -- 否 --> write
    t2 -- 是 --> ex2["执行工具，接回结果"]
    ex2 --> r3["第 3 轮：不带工具，只能写"]
    r3 --> write
    plain --> write
    write --> fin["收尾：解析叙述和选项<br/>缺选项就补 · 隐藏备注存进回合"]
